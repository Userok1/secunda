API_KEY=secret-api-key
POSTGRES_PROTO=postgresql+asyncpg
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=payments
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=payments
DATABASE_URL=${POSTGRES_PROTO}://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_HOST=rabbitmq
RABBITMQ_URL=amqp://${RABBITMQ_USER}:${RABBITMQ_PASSWORD}@${RABBITMQ_HOST}:5672/

# Outbox relay
OUTBOX_POLL_INTERVAL=1.0
OUTBOX_BATCH_SIZE=50

# Payment gateway emulation
PAYMENT_PROCESS_MIN_DELAY=2.0
PAYMENT_PROCESS_MAX_DELAY=5.0
PAYMENT_SUCCESS_RATE=0.9

# Message retry / DLQ
MESSAGE_MAX_ATTEMPTS=3
RETRY_BASE_DELAY_SECONDS=1.0

# Webhook delivery
WEBHOOK_TIMEOUT=10.0
WEBHOOK_MAX_ATTEMPTS=3
WEBHOOK_RETRY_BASE_DELAY=2.0

# Set true to create tables on startup (use Alembic in production)
AUTO_CREATE_TABLES=false
LOG_LEVEL=INFO
